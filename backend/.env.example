# DAY 1 — Spring Boot Foundation
# File: .env.example
# Purpose: Example environment variables for local/dev/prod

# Server
SERVER_PORT=8080

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tool101
POSTGRES_USER=tooluser
POSTGRES_PASSWORD=toolpassword

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION_MS=86400000

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=Tool101 <noreply@tool101.com>

# Swagger
SWAGGER_ENABLED=true
