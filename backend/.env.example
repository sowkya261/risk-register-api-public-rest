
SERVER_PORT=8080

SERVER_PORT=8080

# Example environment variables for local development. Copy to `backend/.env` and edit values.

# Server
SERVER_PORT=8080

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tool101
POSTGRES_USER=tooluser
POSTGRES_PASSWORD=toolpassword

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key_at_least_32_bytes_long
JWT_EXPIRATION_MS=86400000

# Mail (use GreenMail or a real SMTP server)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=Tool101 <noreply@tool101.com>

# Optional flags
SWAGGER_ENABLED=true
